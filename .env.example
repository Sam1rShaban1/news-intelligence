# News Intelligence — environment template
# Copy to `.env` and adjust as needed. All variables use the NEWS_ prefix and are
# read by config/settings.py (see README "Configuration" for details).

# ── Database ───────────────────────────────────────────────────────────────
# Connection string for the Postgres + pgvector database.
NEWS_DATABASE_URL=postgresql://news:news@localhost:5432/news_intelligence

# ── Worker / scheduler ──────────────────────────────────────────────────────
NEWS_POLL_INTERVAL_SECONDS=60
NEWS_BATCH_SIZE=10
NEWS_ZOMBIE_TIMEOUT_MINUTES=5
NEWS_MAX_RETRIES=3
NEWS_SCAN_INTERVAL_MINUTES=60

# ── HTTP fetching ──────────────────────────────────────────────────────────
NEWS_HTTP_TIMEOUT=15
NEWS_USER_AGENT=Mozilla/5.0 (compatible; NewsIntelligence/0.1; +https://github.com/news-intelligence)

# ── Logging ────────────────────────────────────────────────────────────────
NEWS_LOG_LEVEL=INFO

# ── Paths ──────────────────────────────────────────────────────────────────
# Directory that holds sources.yml (relative to the running service / project root).
NEWS_CONFIG_DIR=config

# ── NER model (multilingual GLiNER2 ONNX) ──────────────────────────────────
NEWS_GLINER_MODEL=lmo3/gliner2-multi-v1-onnx

# ── Sentiment model ─────────────────────────────────────────────────────────
# auto = transformer ONNX if present, else VADER lexicon; transformer = force ONNX; lexicon = skip ONNX.
NEWS_SENTIMENT_MODEL=auto
NEWS_SENTIMENT_MODEL_PATH=/app/models/sentiment.onnx
